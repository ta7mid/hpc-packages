--- a/libparmetis/CMakeLists.txt
+++ b/libparmetis/CMakeLists.txt
@@ -7,10 +7,15 @@
 # Create libparmetis
 add_library(parmetis ${ParMETIS_LIBRARY_TYPE} ${parmetis_sources})
 
-if(SHARED)
-  target_link_libraries(parmetis metis GKlib)
+# Public: MPI and metis are visible in parmetis.h (MPI_Comm parameters and
+# #include <metis.h>), so consumers must see them. gklib is an internal
+# implementation detail.
+target_link_libraries(parmetis PUBLIC MPI::MPI_C metis::metis)
+target_link_libraries(parmetis PRIVATE gklib::gklib)
+if(UNIX)
+  target_link_libraries(parmetis PRIVATE m)
 endif()
- 
+
 install(TARGETS parmetis
   LIBRARY DESTINATION lib
   RUNTIME DESTINATION lib
